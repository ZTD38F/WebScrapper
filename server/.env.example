WS_HOST=127.0.0.1
WS_PORT=8787
# Set a long random token if binding beyond localhost.
WS_SERVER_TOKEN=

WS_DATA_DIR=./data
WS_HEADLESS=true
WS_WORKERS=1
WS_POLL_MS=750
WS_LEASE_SECONDS=300
WS_NAVIGATION_TIMEOUT_MS=45000
WS_ACTION_TIMEOUT_MS=15000

# 0 = no WebScrapper wall-clock cap. Jobs still stop on normal pagination/stagnation conditions.
WS_MAX_JOB_MS=0
WS_SCREENSHOT_QUALITY=65

# Optional OpenAI-compatible endpoint.
WS_AI_ENDPOINT=http://127.0.0.1:11434/v1
WS_AI_MODEL=
WS_AI_VISION_MODEL=
WS_AI_API_KEY=
